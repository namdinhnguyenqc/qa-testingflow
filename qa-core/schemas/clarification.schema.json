{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClarificationQuestions",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_key": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["business_rule", "validation", "permission", "state", "error", "ui_conflict"]
          },
          "question": { "type": "string" },
          "reason_required": { "type": "string" },
          "is_critical": { "type": "boolean" },
          "related_sources": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["question_key", "category", "question", "reason_required", "is_critical"]
      }
    }
  },
  "required": ["questions"]
}
