{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FeatureUnderstanding",
  "type": "object",
  "properties": {
    "ready_for_official_testcases": {
      "type": "boolean",
      "description": "Xác định xem tất cả critical gaps đã được làm rõ chưa."
    },
    "goal": { "type": "string" },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["role", "description"]
      }
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "steps": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["name", "steps"]
      }
    },
    "confirmed_business_rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confirmed_validations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": { "type": "string" },
          "rules": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["field", "rules"]
      }
    },
    "state_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "trigger": { "type": "string" }
        },
        "required": ["from", "to", "trigger"]
      }
    },
    "error_handling_rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "remaining_non_critical_assumptions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "ready_for_official_testcases",
    "goal",
    "actors",
    "preconditions",
    "flows",
    "confirmed_business_rules",
    "confirmed_validations",
    "state_transitions",
    "error_handling_rules",
    "remaining_non_critical_assumptions"
  ]
}
