# App Configuration
NEXT_PUBLIC_APP_NAME="QAFlow AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_BUILD_COMMIT="local"

# Supabase Settings - Public Client Safe
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Settings - Server Side Only
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Provider Settings - Server Side Only
# Phase 01B supports openai-compatible providers such as OpenAI, DeepSeek,
# or other providers exposing /chat/completions with bearer auth.
AI_PROVIDER_TYPE="openai-compatible"
AI_PROVIDER_BASE_URL="https://api.openai.com/v1"
AI_PROVIDER_API_KEY="your-ai-api-key"
AI_DEFAULT_MODEL="gpt-4o"

# Application Mode
APP_ACCESS_MODE="demo"
# Allowed: demo | team | production
# Demo may use mocked AI outputs.
# Team/production require real Supabase and AI provider configuration.
