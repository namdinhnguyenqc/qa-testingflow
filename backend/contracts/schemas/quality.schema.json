{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality_schema_v1",
  "title": "Requirement Quality Output",
  "type": "object",
  "required": ["score", "breakdown", "recommendations"],
  "properties": {
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "breakdown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension", "score", "reason"],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": ["clarity", "completeness", "consistency", "testability", "atomicity", "traceability", "ambiguity", "feasibility"]
          },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "reason": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
