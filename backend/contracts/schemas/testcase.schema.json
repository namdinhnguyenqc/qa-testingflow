{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testcase_schema_v1",
  "title": "Testcase Generator Output",
  "type": "object",
  "required": ["testCases"],
  "properties": {
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "preconditions", "steps", "expectedResult", "priority", "type", "requirementRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^TC_[A-Z0-9]+_[A-Z0-9]+_[0-9]{3}$" },
          "module": { "type": "string" },
          "feature": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "preconditions": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["stepNo", "action", "expected"],
              "properties": {
                "stepNo": { "type": "integer", "minimum": 1 },
                "action": { "type": "string", "minLength": 1 },
                "expected": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "expectedResult": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "type": { "type": "string", "enum": ["positive", "negative", "boundary", "security", "accessibility", "regression"] },
          "requirementRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
