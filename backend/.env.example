NODE_ENV=development
PORT=3000

# Supabase Postgres connection string.
# Recommended pooler format:
# postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-qa-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini

DEFAULT_LANGUAGE=vi
MAX_FILE_SIZE_DOC_MB=30
MAX_FILE_SIZE_XLSX_MB=20
MAX_FILE_SIZE_IMAGE_MB=10
MAX_FILE_SIZE_GLOBAL_MB=30
